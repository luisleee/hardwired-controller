# =============================================================================
# Quartus Settings File — project.qsf
#
# Target device : Altera/Intel MAX EPM7128S CPLD
#
# IMPORTANT:
#   1. Replace the DEVICE string below if your exact package/speed grade differs.
#   2. Replace every PIN_* placeholder with the real package pin from your board.
#   3. MAX7000-class CPLDs do not use the MAX10-specific flash assignments or SDC.
# =============================================================================

# ---- Device ---------------------------------------------------------------
set_global_assignment -name FAMILY "MAX 7000S"
set_global_assignment -name DEVICE EPM7128SLC84-15

# ---- Project --------------------------------------------------------------
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ---- Source files ---------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/alu.sv

# ---- Misc -----------------------------------------------------------------
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# =============================================================================
# Pin assignments — replace all placeholders with your actual package pins
# =============================================================================

set_location_assignment PIN_1  -to SW[0]
set_location_assignment PIN_2  -to SW[1]
set_location_assignment PIN_3  -to SW[2]
set_location_assignment PIN_4  -to SW[3]
set_location_assignment PIN_5  -to SW[4]
set_location_assignment PIN_6  -to SW[5]
set_location_assignment PIN_7  -to SW[6]
set_location_assignment PIN_8  -to SW[7]
set_location_assignment PIN_9  -to SW[8]
set_location_assignment PIN_10 -to SW[9]

set_location_assignment PIN_11 -to LED[0]
set_location_assignment PIN_12 -to LED[1]
set_location_assignment PIN_13 -to LED[2]
set_location_assignment PIN_14 -to LED[3]
set_location_assignment PIN_15 -to LED[4]
set_location_assignment PIN_16 -to LED[5]
set_location_assignment PIN_17 -to LED[6]
set_location_assignment PIN_18 -to LED[7]
set_location_assignment PIN_19 -to LED[8]
set_location_assignment PIN_20 -to LED[9]
